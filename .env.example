# growth-agent environment
# Copy to .env (git-ignored) and paste keys. Never commit .env. Never print keys in logs or chat.
# Any key left empty => that provider runs in DEMO mode (labelled fixtures). The app still works end to end.

# ---------------------------------------------------------------------------
# CORE (these six are all we need tonight)
# ---------------------------------------------------------------------------
# Claude = the brain: research reasoning, interview, channel strategy, scripts, compliance.
ANTHROPIC_API_KEY=
ENGINE_MODEL=claude-opus-5-5

# OpenAI = keyframe images, voiceover (TTS), transcription of competitor videos.
OPENAI_API_KEY=

# Apify = scrapers: Meta Ad Library, TikTok, Instagram, Reddit, reviews.
APIFY_TOKEN=

# Manus = deep research task + campaign landing page (API v2, https://open.manus.im/docs).
MANUS_API_KEY=

# Firecrawl = clean crawl of brand and competitor websites (intake + research).
FIRECRAWL_API_KEY=

# fal = video from keyframes (Kling / Seedance) and extra image models.
FAL_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL (leave empty if you don't have them; demo data is used)
# ---------------------------------------------------------------------------
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
YOUTUBE_API_KEY=
SPIRAL_API_KEY=
# Brand data connectors (per brand; demo if empty)
REVENUECAT_API_KEY=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
STRIPE_SECRET_KEY=
PADDLE_API_KEY=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# SPEND CAPS (USD per night). The app refuses any live call past a cap.
# ---------------------------------------------------------------------------
BUDGET_USD_ANTHROPIC=150
BUDGET_USD_OPENAI=60
BUDGET_USD_FAL=8
BUDGET_USD_HIGGSFIELD=8
BUDGET_USD_APIFY=4
BUDGET_USD_FIRECRAWL=3
BUDGET_MANUS_CREDITS=500

# Providers that make real calls. Others (or empty keys) run on demo data.
# Tests and `pnpm check` NEVER call live APIs. fal / Apify / Manus / Higgsfield get one recorded
# smoke test each tonight (`pnpm smoke <provider> --live`) plus the A14 real-data pass.
LIVE_PROVIDERS=anthropic,openai,firecrawl,youtube

# ---------------------------------------------------------------------------
# LOCAL (defaults work as is)
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/nexus.db
ASSETS_DIR=./data/assets
NEXT_PUBLIC_DATA_MODE=live
