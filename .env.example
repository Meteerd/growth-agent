# growth-agent environment
# Copy to .env (git-ignored) and paste keys. Never commit .env. Never print keys in logs or chat.
# Any key left empty => that provider runs in DEMO mode (deterministic fixtures, labelled as demo data).

# ---------------------------------------------------------------------------
# 1. CORE ENGINE (required)
# ---------------------------------------------------------------------------
# Claude = the brain of everything (orchestrator, interview chat, strategy, scripts, compliance).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ENGINE_MODEL=claude-opus-5-5

# OpenAI = image generation (keyframes/statics), TTS fallback, LLM fallback.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 2. DATA IN (research / niche intelligence)
# ---------------------------------------------------------------------------
# Apify = scrapers (Meta Ad Library, TikTok, Instagram, Reddit, Google Maps, app stores, website crawl).
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Manus = deep research tasks (Wide Research) + landing pages. API v2: https://open.manus.im/docs
# https://manus.im -> Settings -> API
MANUS_API_KEY=

# Optional extra data sources
# Firecrawl (student deal) = clean site crawl. https://firecrawl.dev
FIRECRAWL_API_KEY=
# Browser Use (student deal) = cloud browser agent for pages scrapers cannot read. https://browser-use.com
BROWSER_USE_API_KEY=
YOUTUBE_API_KEY=
SPIRAL_API_KEY=

# ---------------------------------------------------------------------------
# 3. CREATIVE OUT (video / image / voice)
# ---------------------------------------------------------------------------
# fal = video + image models (Kling 3.0, Seedance 2.0, Flux, ...). https://fal.ai/dashboard/keys
FAL_KEY=

# Higgsfield = alternative video provider. Paste whatever the dashboard gives (key, or key + secret).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ElevenLabs = voiceover (optional; falls back to Deepgram Aura TTS, then OpenAI TTS). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Deepgram ($15K student credits) = transcribe competitor videos (exact hooks/scripts) + Aura TTS voiceover.
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# Tavus = AI talking-head / UGC-style presenter videos (student deal, redeem first). https://platform.tavus.io
TAVUS_API_KEY=
# sync. = lip-sync / video translation for localizing a talking head (student deal). https://sync.so
SYNC_API_KEY=

# ---------------------------------------------------------------------------
# 4. BUSINESS TRUTH (per-brand connectors; optional tonight, demo mode if empty)
# ---------------------------------------------------------------------------
REVENUECAT_API_KEY=
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
STRIPE_SECRET_KEY=
PADDLE_API_KEY=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# 4b. OBSERVABILITY + BACKUP ENGINE (optional)
# ---------------------------------------------------------------------------
# Langfuse (student deal) = trace every agent step, cost and latency. https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# AWS ($10K credits) = Claude via Amazon Bedrock as a backup engine if the Anthropic key hits limits.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# 5. SPEND CAPS (USD per night). Guards against runaway loops; the engine refuses any live call past a cap.
#    Claude (~$5K credits) and OpenAI (~$2K) are plentiful. fal, Higgsfield, Apify, Manus, ElevenLabs are scarce tonight.
# ---------------------------------------------------------------------------
BUDGET_USD_ANTHROPIC=150
BUDGET_USD_OPENAI=60
BUDGET_USD_DEEPGRAM=20
BUDGET_USD_FAL=8
BUDGET_USD_HIGGSFIELD=8
BUDGET_USD_APIFY=4
BUDGET_USD_ELEVENLABS=3
BUDGET_USD_TAVUS=5
BUDGET_USD_SYNC=5
BUDGET_USD_FIRECRAWL=3
BUDGET_MANUS_CREDITS=500

# Which providers make real calls. Providers not listed (or with an empty key) run in demo mode with labelled fixtures.
# Unit tests and `pnpm check` NEVER call live providers (recorded responses only).
# Scarce providers get exercised by explicit smoke scripts (`pnpm smoke <provider>`) and the A15 real-data pass.
LIVE_PROVIDERS=anthropic,openai,deepgram,firecrawl

# ---------------------------------------------------------------------------
# 6. LOCAL INFRA (defaults work out of the box)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://nexus:nexus@localhost:5433/nexus
ENGINE_PORT=4100
WEB_PORT=3100
NEXT_PUBLIC_ENGINE_URL=http://localhost:4100
NEXT_PUBLIC_ENGINE_MODE=live
ASSETS_DIR=./data/assets
